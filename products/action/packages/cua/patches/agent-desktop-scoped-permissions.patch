@@ -0,0 +1,127 @@
+use agent_desktop_core::AdapterError;
+use std::sync::mpsc::{self, Receiver, RecvTimeoutError, Sender};
+use std::thread::{self, JoinHandle};
+use std::time::Duration;
+
+const MAX_LIFETIME: Duration = Duration::from_secs(120);
+const PARENT_POLL_INTERVAL: Duration = Duration::from_millis(50);
+const EXPIRED_EXIT_CODE: i32 = 2;
+
+pub(super) struct HelperLifetime {
+    stop: Sender<()>,
+    worker: Option<JoinHandle<()>>,
+}
+
+impl Drop for HelperLifetime {
+    fn drop(&mut self) {
+        let _ = self.stop.send(());
+        if let Some(worker) = self.worker.take() {
+            let _ = worker.join();
+        }
+    }
+}
+
+pub(super) fn expires_after(remaining: Duration) -> Result<u64, String> {
+    if remaining.is_zero() || remaining > MAX_LIFETIME {
+        return Err("permission helper lifetime must be positive and at most 120 seconds".into());
+    }
+    let nanos = u64::try_from(remaining.as_nanos())
+        .map_err(|_| "permission helper lifetime is out of range".to_string())?;
+    monotonic_nanos()?
+        .checked_add(nanos)
+        .ok_or_else(|| "permission helper deadline is out of range".into())
+}
+
+pub(super) fn remaining_until(expires_at: u64) -> Result<Duration, String> {
+    let remaining = expires_at
+        .checked_sub(monotonic_nanos()?)
+        .map(Duration::from_nanos)
+        .filter(|value| !value.is_zero() && *value <= MAX_LIFETIME)
+        .ok_or_else(|| "permission helper deadline expired or exceeds 120 seconds".to_string())?;
+    Ok(remaining)
+}
+
+pub(super) fn watch_parent(
+    parent_pid: i32,
+    parent_instance: String,
+    expires_at: u64,
+) -> Result<HelperLifetime, String> {
+    arm(expires_at, move || {
+        parent_is_current(
+            parent_pid,
+            &parent_instance,
+            unsafe { libc::getppid() },
+            crate::system::process::process_identity::matches_instance,
+        )
+    })
+}
+
+fn parent_is_current(
+    expected_pid: i32,
+    expected_instance: &str,
+    actual_parent: i32,
+    matches_instance: impl FnOnce(i32, &str) -> Result<bool, AdapterError>,
+) -> bool {
+    expected_pid > 0
+        && actual_parent == expected_pid
+        && matches!(matches_instance(expected_pid, expected_instance), Ok(true))
+}
+
+fn arm(
+    expires_at: u64,
+    parent_is_current: impl Fn() -> bool + Send + 'static,
+) -> Result<HelperLifetime, String> {
+    remaining_until(expires_at)?;
+    if !parent_is_current() {
+        return Err("permission helper parent changed before its watchdog started".into());
+    }
+    let (stop, receiver) = mpsc::channel();
+    let worker = thread::Builder::new()
+        .name("permission-helper-lifetime".into())
+        .spawn(move || supervise(expires_at, receiver, parent_is_current))
+        .map_err(|error| format!("Could not start permission helper watchdog: {error}"))?;
+    Ok(HelperLifetime {
+        stop,
+        worker: Some(worker),
+    })
+}
+
+fn supervise(expires_at: u64, stop: Receiver<()>, parent_is_current: impl Fn() -> bool) {
+    loop {
+        let remaining = match remaining_until(expires_at) {
+            Ok(remaining) if parent_is_current() => remaining,
+            _ => unsafe { libc::_exit(EXPIRED_EXIT_CODE) },
+        };
+        match stop.recv_timeout(remaining.min(PARENT_POLL_INTERVAL)) {
+            Ok(()) | Err(RecvTimeoutError::Disconnected) => return,
+            Err(RecvTimeoutError::Timeout) => {}
+        }
+    }
+}
+
+fn monotonic_nanos() -> Result<u64, String> {
+    let mut time = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    if unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut time) } != 0 {
+        return Err(format!(
+            "Could not read permission helper clock: {}",
+            std::io::Error::last_os_error()
+        ));
+    }
+    let seconds = u64::try_from(time.tv_sec)
+        .map_err(|_| "permission helper clock is out of range".to_string())?;
+    let nanos = u64::try_from(time.tv_nsec)
+        .ok()
+        .filter(|nanos| *nanos < 1_000_000_000)
+        .ok_or_else(|| "permission helper clock fraction is out of range".to_string())?;
+    seconds
+        .checked_mul(1_000_000_000)
+        .and_then(|value| value.checked_add(nanos))
+        .ok_or_else(|| "permission helper clock is out of range".into())
+}
+
+#[cfg(test)]
+#[path = "permission_helper_lifetime_tests.rs"]
+mod tests;
