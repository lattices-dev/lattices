+use super::*;
+use crate::{AdapterError, InteractionLease, SystemOps};
+use std::sync::{
+    Mutex,
+    atomic::{AtomicUsize, Ordering},
+};
+
+struct PermissionAdapter {
+    leases: AtomicUsize,
+    legacy: AtomicUsize,
+    selected: Mutex<Vec<PermissionKind>>,
+    supported: bool,
+}
+
+impl crate::ObservationOps for PermissionAdapter {}
+impl crate::InputOps for PermissionAdapter {}
+impl crate::ActionOps for PermissionAdapter {}
+impl SystemOps for PermissionAdapter {
+    fn acquire_interaction_lease(
+        &self,
+        deadline: Deadline,
+    ) -> Result<InteractionLease, AdapterError> {
+        self.leases.fetch_add(1, Ordering::SeqCst);
+        assert_eq!(deadline.timeout_ms(), 37);
+        InteractionLease::guarded(deadline, ())
+    }
+
+    fn scoped_permission_requests(&self) -> &'static [PermissionKind] {
+        if self.supported {
+            &PermissionKind::ALL
+        } else {
+            &[]
+        }
+    }
+
+    fn request_selected_permissions(
+        &self,
+        permissions: &[PermissionKind],
+        _: &InteractionLease,
+    ) -> Result<PermissionReport, AdapterError> {
+        *self.selected.lock().unwrap() = permissions.to_vec();
+        Ok(PermissionReport::default())
+    }
+
+    fn request_permissions(&self, _: &InteractionLease) -> Result<PermissionReport, AdapterError> {
+        self.legacy.fetch_add(1, Ordering::SeqCst);
+        Ok(PermissionReport::default())
+    }
+}
+
+fn adapter(supported: bool) -> PermissionAdapter {
+    PermissionAdapter {
+        leases: AtomicUsize::new(0),
+        legacy: AtomicUsize::new(0),
+        selected: Mutex::new(Vec::new()),
+        supported,
+    }
+}
+
+fn args(request: bool, only: Option<Vec<&str>>, timeout_ms: Option<u64>) -> PermissionsArgs {
+    PermissionsArgs {
+        request,
+        guide: false,
+        only: only.map(|values| values.into_iter().map(str::to_owned).collect()),
+        timeout_ms,
+    }
+}
+
+#[test]
+fn permissions_scoped_requests_never_fall_back_to_legacy() {
+    let adapter = adapter(true);
+    execute_with_report(
+        args(
+            true,
+            Some(vec!["accessibility", "screen-recording", "accessibility"]),
+            Some(37),
+        ),
+        &adapter,
+        &PermissionReport::default(),
+    )
+    .unwrap();
+    assert_eq!(
+        *adapter.selected.lock().unwrap(),
+        vec![
+            PermissionKind::Accessibility,
+            PermissionKind::ScreenRecording
+        ]
+    );
+    assert_eq!(adapter.legacy.load(Ordering::SeqCst), 0);
+    assert_eq!(adapter.leases.load(Ordering::SeqCst), 1);
+
+    execute_with_report(
+        args(true, None, Some(37)),
+        &adapter,
+        &PermissionReport::default(),
+    )
+    .unwrap();
+    assert_eq!(adapter.legacy.load(Ordering::SeqCst), 1);
+}
+
+#[test]
+fn permissions_invalid_selection_never_acquires_lease_or_prompts() {
+    let adapter = adapter(true);
+    for request in [
+        args(false, Some(vec!["accessibility"]), None),
+        args(true, Some(vec![]), None),
+        args(true, Some(vec![""]), None),
+        args(true, Some(vec!["accessibility", "camera"]), None),
+        args(true, Some(vec!["accessibility"]), Some(120_001)),
+        args(false, None, Some(37)),
+    ] {
+        assert_eq!(
+            execute_with_report(request, &adapter, &PermissionReport::default())
+                .unwrap_err()
+                .code(),
+            "INVALID_ARGS"
+        );
+    }
+    assert_eq!(adapter.leases.load(Ordering::SeqCst), 0);
+    assert_eq!(adapter.legacy.load(Ordering::SeqCst), 0);
+    assert!(adapter.selected.lock().unwrap().is_empty());
+}
+
+#[test]
+fn permissions_expired_or_unsupported_selection_never_prompts() {
+    for (adapter, timeout_ms, code) in [
+        (adapter(true), 0, "TIMEOUT"),
+        (adapter(false), 37, "PLATFORM_NOT_SUPPORTED"),
+    ] {
+        let error = execute_with_report(
+            args(true, Some(vec!["accessibility"]), Some(timeout_ms)),
+            &adapter,
+            &PermissionReport::default(),
+        )
+        .unwrap_err();
+        assert_eq!(error.code(), code);
+        assert_eq!(adapter.leases.load(Ordering::SeqCst), 0);
+        assert_eq!(adapter.legacy.load(Ordering::SeqCst), 0);
+    }
+}
+
+#[test]
+fn permissions_plain_report_advertises_only_implemented_scoped_requests() {
+    for supported in [false, true] {
+        let adapter = adapter(supported);
+        let result = execute_with_report(
+            args(false, None, None),
+            &adapter,
+            &PermissionReport::default(),
+        )
+        .unwrap();
+        if supported {
+            assert_eq!(
+                result["request_capabilities"],
+                json!({"scoped": true, "permissions": ["accessibility", "screen_recording", "automation"]})
+            );
+        } else {
+            assert!(result.get("request_capabilities").is_none());
+        }
+        assert_eq!(adapter.leases.load(Ordering::SeqCst), 0);
+    }
+}
