+use crate::{AppError, PermissionReport, PermissionState};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum PermissionKind {
+    Accessibility,
+    ScreenRecording,
+    Automation,
+}
+
+impl PermissionKind {
+    pub const ALL: [Self; 3] = [Self::Accessibility, Self::ScreenRecording, Self::Automation];
+
+    pub fn parse_flag(value: &str) -> Result<Self, AppError> {
+        match value {
+            "accessibility" => Ok(Self::Accessibility),
+            "screen-recording" => Ok(Self::ScreenRecording),
+            "automation" => Ok(Self::Automation),
+            _ => Err(AppError::invalid_input(
+                "--only accepts accessibility, screen-recording, or automation",
+            )),
+        }
+    }
+
+    pub fn is_missing(self, report: &PermissionReport) -> bool {
+        let state = match self {
+            Self::Accessibility => &report.accessibility,
+            Self::ScreenRecording => &report.screen_recording,
+            Self::Automation => &report.automation,
+        };
+        !matches!(
+            state,
+            PermissionState::Granted | PermissionState::NotRequired
+        )
+    }
+}
