@@ -0,0 +1,202 @@
+use super::*;
+use std::collections::HashMap;
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, Command, ExitStatus, Stdio};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::Instant;
+
+const TEST_MODE: &str = "AGENT_DESKTOP_PERMISSION_LIFETIME_TEST";
+const CHILD_TEST: &str =
+    "system::permissions::permission_helper::lifetime::tests::inert_watchdog_subprocess";
+
+fn spawn(mode: &str) -> Child {
+    Command::new(std::env::current_exe().unwrap())
+        .args(["--exact", CHILD_TEST, "--nocapture"])
+        .env(TEST_MODE, mode)
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap()
+}
+
+fn wait_for_marker(child: &mut Child) -> String {
+    let stdout = child.stdout.take().unwrap();
+    let (sender, receiver) = mpsc::channel();
+    thread::spawn(move || {
+        for line in BufReader::new(stdout).lines().map_while(Result::ok) {
+            if let Some((_, marker)) = line.split_once("LIFETIME_READY ") {
+                let _ = sender.send(marker.to_string());
+            }
+        }
+    });
+    match receiver.recv_timeout(Duration::from_secs(5)) {
+        Ok(marker) => marker,
+        Err(error) => {
+            let _ = child.kill();
+            let _ = child.wait();
+            panic!("inert helper did not become ready: {error}");
+        }
+    }
+}
+
+fn wait_for_exit(child: &mut Child) -> ExitStatus {
+    let deadline = Instant::now() + Duration::from_secs(5);
+    loop {
+        if let Some(status) = child.try_wait().unwrap() {
+            return status;
+        }
+        if Instant::now() >= deadline {
+            let _ = child.kill();
+            let _ = child.wait();
+            panic!("inert helper survived its lifetime guard");
+        }
+        thread::sleep(Duration::from_millis(10));
+    }
+}
+
+fn parent_identity() -> (i32, String) {
+    let parent = unsafe { libc::getppid() };
+    let instance = crate::system::process::process_identity::token_for_pid(parent)
+        .unwrap()
+        .unwrap();
+    (parent, instance)
+}
+
+fn helper_environment(expires_at: u64) -> HashMap<String, String> {
+    use super::super::{
+        DEADLINE_NS, EXECUTABLE, MARKER, OPERATION, PARENT_INSTANCE, PARENT_PID, PROTOCOL_VERSION,
+        TOKEN, TOKEN_BYTES,
+    };
+    let (parent, instance) = parent_identity();
+    HashMap::from([
+        (MARKER.into(), PROTOCOL_VERSION.into()),
+        (OPERATION.into(), "accessibility".into()),
+        (TOKEN.into(), "ab".repeat(TOKEN_BYTES)),
+        (PARENT_PID.into(), parent.to_string()),
+        (PARENT_INSTANCE.into(), instance),
+        (
+            EXECUTABLE.into(),
+            super::super::canonical_current_executable_text().unwrap(),
+        ),
+        (DEADLINE_NS.into(), expires_at.to_string()),
+    ])
+}
+
+fn signal_ready() {
+    println!("LIFETIME_READY {}", std::process::id());
+    std::io::stdout().flush().unwrap();
+}
+
+#[test]
+fn inert_watchdog_subprocess() {
+    let Ok(mode) = std::env::var(TEST_MODE) else {
+        return;
+    };
+    if mode == "parent" {
+        let mut child = spawn("orphan");
+        wait_for_marker(&mut child);
+        println!("LIFETIME_READY {}", child.id());
+        std::io::stdout().flush().unwrap();
+        let _ = child.wait();
+        return;
+    }
+    let expires_at = expires_after(Duration::from_millis(
+        if matches!(mode.as_str(), "orphan" | "replacement") {
+            15_000
+        } else {
+            500
+        },
+    ))
+    .unwrap();
+    if mode == "replacement" {
+        let checks = AtomicUsize::new(0);
+        let _guard = arm(expires_at, move || {
+            checks.fetch_add(1, Ordering::SeqCst) < 3
+        })
+        .unwrap();
+        signal_ready();
+        loop {
+            thread::park();
+        }
+    }
+    let environment = helper_environment(expires_at);
+    super::super::execute_child_with(&|name| environment.get(name).cloned(), |_| {
+        signal_ready();
+        if mode == "complete" {
+            return true;
+        }
+        loop {
+            thread::park();
+        }
+    })
+    .unwrap();
+    thread::sleep(Duration::from_millis(650));
+}
+
+#[test]
+fn blocked_helper_exits_at_absolute_deadline_while_parent_lives() {
+    let mut child = spawn("deadline");
+    wait_for_marker(&mut child);
+    assert_eq!(wait_for_exit(&mut child).code(), Some(EXPIRED_EXIT_CODE));
+}
+
+#[test]
+fn blocked_helper_exits_when_parent_identity_probe_changes() {
+    let mut child = spawn("replacement");
+    wait_for_marker(&mut child);
+    assert_eq!(wait_for_exit(&mut child).code(), Some(EXPIRED_EXIT_CODE));
+}
+
+#[test]
+fn completed_helper_disarms_watchdog_without_delayed_exit() {
+    let mut child = spawn("complete");
+    wait_for_marker(&mut child);
+    assert!(wait_for_exit(&mut child).success());
+}
+
+#[test]
+fn orphaned_helper_exits_before_its_remaining_deadline() {
+    let mut parent = spawn("parent");
+    let child_pid: i32 = wait_for_marker(&mut parent).parse().unwrap();
+    let instance = crate::system::process::process_identity::token_for_pid(child_pid)
+        .unwrap()
+        .unwrap();
+    parent.kill().unwrap();
+    parent.wait().unwrap();
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while crate::system::process::process_identity::matches_instance(child_pid, &instance).unwrap()
+    {
+        if Instant::now() >= deadline {
+            unsafe { libc::kill(child_pid, libc::SIGKILL) };
+            panic!("owned orphan helper did not exit after parent death");
+        }
+        thread::sleep(Duration::from_millis(10));
+    }
+}
+
+#[test]
+fn parent_checks_reject_reparenting_replacement_and_unreadable_identity() {
+    assert!(parent_is_current(42, "instance", 42, |pid, instance| {
+        assert_eq!((pid, instance), (42, "instance"));
+        Ok(true)
+    }));
+    assert!(!parent_is_current(42, "instance", 1, |_, _| panic!(
+        "detached parent must not be inspected"
+    )));
+    assert!(!parent_is_current(42, "instance", 42, |_, _| Ok(false)));
+    assert!(!parent_is_current(42, "instance", 42, |_, _| Err(
+        AdapterError::internal("no identity")
+    )));
+}
+
+#[test]
+fn lifetime_is_bounded_and_uses_an_absolute_clock() {
+    assert!(expires_after(Duration::ZERO).is_err());
+    assert!(expires_after(Duration::from_secs(121)).is_err());
+    assert!(remaining_until(0).is_err());
+    assert!(remaining_until(u64::MAX).is_err());
+    let deadline = expires_after(Duration::from_secs(1)).unwrap();
+    let first = remaining_until(deadline).unwrap();
+    thread::sleep(Duration::from_millis(5));
+    assert!(remaining_until(deadline).unwrap() < first);
+}
