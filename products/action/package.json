{
  "name": "action",
  "private": true,
  "version": "0.3.1",
  "description": "Native-first macOS capture and demo workstation",
  "homepage": "https://lattices.dev/action",
  "repository": {
    "type": "git",
    "url": "https://github.com/arach/lattices",
    "directory": "products/action"
  },
  "bugs": {
    "url": "https://github.com/arach/lattices/issues"
  },
  "packageManager": "bun@1.3.5",
  "type": "module",
  "bin": {
    "action": "./packages/cli/src/main.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "action": "bun packages/cli/src/main.ts",
    "companion": "bun packages/companion/src/server.ts",
    "companion:status": "CARGO_BIN=${CARGO_BIN:-$HOME/.cargo/bin/cargo}; \"$CARGO_BIN\" run --manifest-path crates/action-supervisor/Cargo.toml -- status --json",
    "companion:start": "CARGO_BIN=${CARGO_BIN:-$HOME/.cargo/bin/cargo}; \"$CARGO_BIN\" run --manifest-path crates/action-supervisor/Cargo.toml -- start --json",
    "companion:stop": "CARGO_BIN=${CARGO_BIN:-$HOME/.cargo/bin/cargo}; \"$CARGO_BIN\" run --manifest-path crates/action-supervisor/Cargo.toml -- stop --json",
    "companion:restart": "CARGO_BIN=${CARGO_BIN:-$HOME/.cargo/bin/cargo}; \"$CARGO_BIN\" run --manifest-path crates/action-supervisor/Cargo.toml -- restart --json",
    "companion:doctor": "CARGO_BIN=${CARGO_BIN:-$HOME/.cargo/bin/cargo}; \"$CARGO_BIN\" run --manifest-path crates/action-supervisor/Cargo.toml -- doctor --json",
    "mcp": "secret run MINIMAX_API_KEY -- bun packages/mcp/src/index.ts",
    "inspect:surface": "secret run MINIMAX_API_KEY -- bun packages/cli/src/main.ts inspect current-surface",
    "inspect:surface:vision": "secret run MINIMAX_API_KEY -- bun packages/cli/src/main.ts inspect current-surface --vision",
    "secrets:status": "scripts/secret-setup.sh status",
    "secrets:setup": "scripts/secret-setup.sh setup",
    "plugin:version": "bun scripts/plugin-version.mjs",
    "release:tag": "scripts/tag-release",
    "release:ship": "scripts/ship-release",
    "media:chroma-window": "bun scripts/chroma-window-video.mjs",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "check:no-wallpaper-writes": "zsh scripts/check-no-wallpaper-writes.sh",
    "docs:generate": "dewey generate",
    "docs:agent": "dewey agent",
    "docs:audit": "dewey audit",
    "demo:calculator": "bun packages/cli/src/main.ts demo calculator-demo mock",
    "demo:notes": "bun packages/cli/src/main.ts demo notes-demo mock",
    "demo:calculator:macos": "bun packages/cli/src/main.ts demo calculator-demo macos",
    "demo:notes:macos": "bun packages/cli/src/main.ts demo notes-demo macos",
    "mira:install": "bun scripts/mira-overlay.mjs install",
    "mira:show": "bun scripts/mira-overlay.mjs show",
    "mira:move": "bun scripts/mira-overlay.mjs move",
    "mira:hide": "bun scripts/mira-overlay.mjs hide",
    "scenario:calculator": "bun packages/cli/src/main.ts scenario calculator-demo",
    "scenario:notes": "bun packages/cli/src/main.ts scenario notes-demo",
    "native:dev": "bun packages/cli/src/action-dev.ts relaunch",
    "native:launch": "bun packages/cli/src/action-dev.ts launch",
    "native:relaunch": "bun packages/cli/src/action-dev.ts relaunch",
    "native:quit": "bun packages/cli/src/action-dev.ts quit",
    "native:logs": "bun packages/cli/src/action-dev.ts logs",
    "native:rebuild": "bun packages/cli/src/action-dev.ts rebuild",
    "native:host": "bun packages/cli/src/action-dev.ts host",
    "native:agent": "bun packages/cli/src/action-dev.ts agent",
    "native:agent-cli": "bun packages/cli/src/action-dev.ts agent-cli",
    "native:app:build": "native/engine/scripts/build-app.sh",
    "native:dmg:build": "Installer/build.sh",
    "native:doctor": "native/engine/scripts/doctor.sh",
    "native:verify": "native/engine/scripts/verify-app.sh",
    "native:permissions:status": "native/engine/scripts/run-app-host.sh status",
    "native:permissions:request": "native/engine/scripts/run-app-host.sh request",
    "native:permissions:open:accessibility": "native/engine/scripts/run-app-host.sh open-accessibility-settings",
    "native:permissions:open:screen-recording": "native/engine/scripts/run-app-host.sh open-screen-recording-settings",
    "native:ax:audit": "native/engine/scripts/audit-daily-app-ax.sh",
    "native:chrome:ax": "native/engine/scripts/test-chrome-ax-control.sh",
    "native:chrome:bg": "native/engine/scripts/test-chrome-background-nav-overlay.sh",
    "native:chrome:record-url": "native/engine/scripts/record-chrome-url-demo.sh",
    "native:midjourney:record-logo": "native/engine/scripts/record-mira-midjourney-logo-demo.sh",
    "chrome:companion:build": "cd packages/chrome-companion && bun run build",
    "chrome:companion:bridge": "cd packages/chrome-companion && bun run bridge",
    "chrome:companion:health": "cd packages/chrome-companion && bun run health",
    "chrome:companion:install:dev": "cd packages/chrome-companion && bun run install:dev",
    "chrome:companion:brand:prompts": "cd packages/chrome-companion && bun run brand:prompts",
    "chrome:companion:logo:sprint": "cd packages/chrome-companion && bun run logo:sprint",
    "chrome:companion:logo:sprint:once": "cd packages/chrome-companion && bun run logo:sprint:once",
    "chrome:companion:logo:analyze": "cd packages/chrome-companion && bun run logo:analyze",
    "chrome:companion:logo:analyze:once": "cd packages/chrome-companion && bun run logo:analyze:once",
    "chrome:companion:character:prompts": "cd packages/chrome-companion && bun run character:prompts",
    "chrome:companion:sprite:prompts": "cd packages/chrome-companion && bun run sprite:prompts",
    "chrome:companion:actor:prompts": "cd packages/chrome-companion && bun run actor:prompts",
    "chrome:companion:actor:prompts:generate": "cd packages/chrome-companion && bun run actor:prompts:generate",
    "chrome:companion:cast:prompts": "cd packages/chrome-companion && bun run cast:prompts",
    "chrome:companion:cast:prompts:generate": "cd packages/chrome-companion && bun run cast:prompts:generate",
    "chrome:companion:cast:animals:merge": "cd packages/chrome-companion && bun run cast:animals:merge",
    "chrome:companion:cast:variations": "cd packages/chrome-companion && bun run cast:variations",
    "chrome:companion:cast:actions": "cd packages/chrome-companion && bun run cast:actions",
    "chrome:companion:cast:animate": "cd packages/chrome-companion && bun run cast:animate",
    "chrome:companion:cast:marathon": "cd packages/chrome-companion && bun run cast:marathon",
    "chrome:companion:mj:sync": "cd packages/chrome-companion && bun run mj:sync",
    "chrome:companion:import:cookies": "cd packages/chrome-companion && bun run import:cookies",
    "chrome:companion:install": "cd packages/chrome-companion && bun run install:self",
    "chrome:companion:launch:profile": "cd packages/chrome-companion && bun run launch:profile",
    "chrome:companion:profile": "cd packages/chrome-companion && bun run profile",
    "chrome:profiles": "cd packages/chrome-companion && bun scripts/import-cookies.mjs --list-action-profiles",
    "native:midjourney:bg": "native/engine/scripts/test-midjourney-background-create.sh",
    "native:typing:sounds:install": "native/engine/scripts/install-typing-sounds.sh",
    "native:test:screenshot": "native/engine/scripts/test-screenshot.sh",
    "native:test:record": "native/engine/scripts/test-record.sh"
  },
  "devDependencies": {
    "@arach/dewey": "^0.3.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1"
  }
}
