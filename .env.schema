# Lattices environment.
#
# Every variable Lattices reads, in one place. Nothing here holds a value:
# credentials live in the macOS login keychain and the runtime reads them
# itself (bin/infer.ts: process env first, then service `lattices.inference`).
# Varlock is a dev-time tool only: `bunx varlock load` checks this schema,
# `bunx varlock run -- <cmd>` injects it, and `bunx varlock scan` guards commits.
#
# Store a provider key without putting it on a command line:
#   security add-generic-password -U -s lattices.inference -a groq -w
#
# @defaultSensitive=false
# @defaultRequired=false
# ---

# --- Inference provider keys (keychain service lattices.inference) ---
# @sensitive
GROQ_API_KEY=exec(`/usr/bin/security find-generic-password -s lattices.inference -a groq -w 2>/dev/null || true`)
# @sensitive
OPENAI_API_KEY=exec(`/usr/bin/security find-generic-password -s lattices.inference -a openai -w 2>/dev/null || true`)
# @sensitive
ANTHROPIC_API_KEY=exec(`/usr/bin/security find-generic-password -s lattices.inference -a anthropic -w 2>/dev/null || true`)
# @sensitive
GOOGLE_GENERATIVE_AI_API_KEY=exec(`/usr/bin/security find-generic-password -s lattices.inference -a google -w 2>/dev/null || true`)
# @sensitive
XAI_API_KEY=exec(`/usr/bin/security find-generic-password -s lattices.inference -a xai -w 2>/dev/null || true`)
# @sensitive
MINIMAX_API_KEY=exec(`/usr/bin/security find-generic-password -s lattices.inference -a minimax -w 2>/dev/null || true`)

# --- Other credentials ---
# Bearer token for a Vox runtime that requires one.
# @sensitive
VOX_AUTH_TOKEN=
# npm publish token, release only. Inject with `secret run NPM_TOKEN -- ...`.
# @sensitive
NPM_TOKEN=

# --- Inference and voice ---
LATTICES_INFER_PROVIDER=
LATTICES_INFER_MODEL=
LATTICES_VOICE_PROVIDER=
LATTICES_VOICE_MODEL=
LATTICES_HANDSOFF_PROVIDER=
LATTICES_HANDSOFF_MODEL=
LATTICES_VOICE_CAPABILITY=

# --- Daemon and gateway ---
LATTICES_DAEMON_HOST=
# @type=port
LATTICES_DAEMON_PORT=
LATTICES_RUNTIME_DIR=
# Opens the daemon on loopback TCP for clients that cannot reach the socket.
# Any local process can then connect; leave unset unless you need it.
# @type=enum(0, 1)
LATTICES_ALLOW_LOOPBACK_TCP=

# --- Build and release ---
LATTICES_BUILD_CHANNEL=
LATTICES_TIER=
LATTICES_SIGN_IDENTITY=
LATTICES_NOTARY_PROFILE=
LATTICES_SKIP_HELPERS=

# --- Computer use smoke tests ---
# @type=boolean
LATTICES_CUA_SELF_SMOKE=
# @type=boolean
LATTICES_CUA_TEXT_SMOKE=
LATTICES_CUA_SMOKE_OUTPUT=

# --- Virtual displays and visits (Linux host) ---
LATTICES_VISITOR_RUNTIME_DIR=
LATTICES_VIRTUAL_RUNTIME=
LATTICES_VIRTUAL_LIBRARY_PATH=
LATTICES_VIRTUAL_SWAY=
# @type=number
LATTICES_VIRTUAL_WIDTH=
# @type=number
LATTICES_VIRTUAL_HEIGHT=
LATTICES_STREAM_ENCODER=
LATTICES_WORKSPACE_DIR=

# --- Canvas ---
# Takes precedence over BLINK_HOME when nonempty.
CANVAS_HOME=
BLINK_HOME=

# --- Action ---
ACTION_ROOT=
ACTION_SOCKET_PATH=
ACTION_BROWSER_ARTIFACT_DIR=
ACTION_BROWSER_CHROME_APP=
# @type=port
ACTION_BROWSER_DEBUG_PORT=
# @type=number
ACTION_BROWSER_IDLE_TIMEOUT_MS=
# @type=number
ACTION_BROWSER_SHUTDOWN_TIMEOUT_MS=
ACTION_BROWSER_PROFILE=
ACTION_BROWSER_PROFILE_DIR=
ACTION_BROWSER_PROFILE_ROOT=
ACTION_BROWSER_SESSION=
ACTION_BROWSER_SESSION_DIR=
ACTION_CHROME_COMPANION_PROFILE=
ACTION_CHROME_COMPANION_PROFILE_DIR=
ACTION_CHROME_COMPANION_PROFILE_ROOT=

# --- Misc ---
# Set by tmux inside a session.
TMUX=
LATTICE_SCAN_ROOT=
PI_BIN=
SPEECH_REVIEW_APP=
