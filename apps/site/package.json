{
  "name": "www",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run content:prepare && bun run blink:styles && vite",
    "clean": "rm -rf dist .astro private-dist .worker-assets",
    "build": "bun run content:prepare && bun run blink:styles && bun run clean && vite build && bun scripts/export-static.mjs && bun scripts/audit-access-build.ts && pagefind --site dist && bun scripts/assemble-worker-assets.ts",
    "test:analytics": "bun test scripts/analytics.test.ts scripts/static-preview.test.ts",
    "test:analytics:integration": "bun test scripts/analytics.integration.test.ts",
    "check:analytics": "bun run test:analytics && bun run build && bun run test:analytics:integration",
    "agent-docs": "bun run build",
    "audit:learning": "bun scripts/audit-learning.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "brand": "bun scripts/export-brand.tsx",
    "og": "node scripts/generate-og.js",
    "render:gesture": "remotion render scripts/remotion/gesture-completion.tsx GestureCompletion public/blog/gesture-completion-matrix.mp4 --codec h264 --pixel-format yuv420p",
    "render:gesture:poster": "remotion still scripts/remotion/gesture-completion.tsx GestureCompletion public/blog/gesture-completion-matrix-poster.png --frame 344",
    "blink:styles": "node scripts/build-blink-styles.mjs",
    "content:prepare": "bun scripts/prepare-doc-content.ts",
    "preview:access": "bun scripts/serve-access.ts",
    "test:access": "bun test server/access.test.ts scripts/doc-access.test.ts",
    "deploy:cloudflare": "bun run check:analytics && bun run test:access && wrangler deploy"
  },
  "dependencies": {
    "@arach/arc": "^0.9.1",
    "github-slugger": "^2.0.0",
    "motion": "^12.42.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@arach/og": "^0.3.0",
    "@eslint/js": "^9.39.1",
    "@remotion/cli": "^4.0.457",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "marked": "^17.0.1",
    "pagefind": "^1.5.2",
    "puppeteer": "^24.37.5",
    "remotion": "^4.0.457",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wrangler": "4.158.0"
  }
}
