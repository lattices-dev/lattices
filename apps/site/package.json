{
  "name": "www",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run blink:styles && vite",
    "clean": "rm -rf dist .astro",
    "build": "bun run blink:styles && bun run clean && vite build && bun scripts/export-static.mjs && pagefind --site dist",
    "agent-docs": "node scripts/agent-docs.mjs",
    "audit:learning": "bun scripts/audit-learning.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "brand": "bun scripts/export-brand.tsx",
    "og": "node scripts/generate-og.js",
    "render:gesture": "remotion render scripts/remotion/gesture-completion.tsx GestureCompletion public/blog/gesture-completion-matrix.mp4 --codec h264 --pixel-format yuv420p",
    "render:gesture:poster": "remotion still scripts/remotion/gesture-completion.tsx GestureCompletion public/blog/gesture-completion-matrix-poster.png --frame 344",
    "blink:styles": "node scripts/build-blink-styles.mjs"
  },
  "dependencies": {
    "@arach/arc": "^0.9.1",
    "motion": "^12.42.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@arach/og": "^0.3.0",
    "@eslint/js": "^9.39.1",
    "@remotion/cli": "^4.0.457",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "marked": "^17.0.1",
    "pagefind": "^1.5.2",
    "puppeteer": "^24.37.5",
    "remotion": "^4.0.457",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
