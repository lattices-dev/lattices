{
  "name": "@arach/lattices",
  "version": "0.13.5",
  "description": "Tile windows, search your screen, keep tmux sessions alive, and let AI agents control your Mac — CLI + daemon API",
  "homepage": "https://lattices.dev",
  "bugs": {
    "url": "https://github.com/arach/lattices/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "lattices": "./bin/lattices",
    "lats": "./bin/lattices",
    "lattices-app": "./bin/lattices-app.ts"
  },
  "keywords": [
    "lattices",
    "macos",
    "workspace",
    "window-manager",
    "tmux",
    "daemon",
    "ai-agents",
    "claude",
    "developer-tools",
    "cli",
    "terminal",
    "ocr",
    "tiling"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arach/lattices"
  },
  "license": "MIT",
  "exports": {
    ".": "./bin/client.ts",
    "./assistant-intelligence": "./bin/assistant-intelligence.ts",
    "./cua": "./bin/cua.ts",
    "./daemon-client": "./bin/daemon-client.ts",
    "./project-twin": "./bin/project-twin.ts"
  },
  "scripts": {
    "dev": "bun --cwd apps/site dev",
    "site:build": "bun --cwd apps/site build",
    "action": "bun --cwd products/action action",
    "action:dev": "bun --cwd products/action native:relaunch",
    "action:launch": "bun --cwd products/action native:launch",
    "action:check": "bun --cwd products/action typecheck && bun --cwd products/action check:no-wallpaper-writes",
    "action:native:build": "bun --cwd products/action native:app:build",
    "action:native:doctor": "bun --cwd products/action native:doctor",
    "blink:check": "swift test --package-path products/blink",
    "blink:build": "swift build --package-path products/blink",
    "studio:dev": "bun --cwd apps/studio dev",
    "studio:build": "bun --cwd apps/studio build",
    "docs:agent": "bun --cwd apps/site agent-docs",
    "check": "bun run check:types && bun run check:app",
    "check:types": "tsc --noEmit",
    "check:app": "env CLANG_MODULE_CACHE_PATH=/tmp/lattices-clang-cache SWIFTPM_TESTS_MODULECACHE=/tmp/lattices-swiftpm-cache swift build --package-path apps/mac",
    "test": "node --experimental-strip-types --test tests/cli.test.mjs tests/cli-subprocess.test.mjs && bun test tests/dependency-free.test.ts tests/skills.test.ts tests/linux-hints.test.ts tests/linux-search.test.ts tests/linux-desktop-cli.test.ts tests/linux-flight-deck.test.ts tests/linux-flight-canvas.test.ts tests/linux-desktop-views.test.ts tests/linux-appearance.test.ts tests/linux-app-backend.test.ts tests/linux-viewer-cli.test.ts tests/linux-install.test.ts",
    "test:linux-app": "bun apps/linux/check.ts",
    "test:cli": "node --experimental-strip-types --test tests/cli.test.mjs tests/cli-subprocess.test.mjs",
    "test:dependencies": "bun test tests/dependency-free.test.ts",
    "test:e2e": "node --experimental-strip-types --test tests/e2e-daemon.test.mjs",
    "test:e2e:voice": "node --experimental-strip-types tests/eval-voice.js",
    "typecheck": "bun run check:types",
    "build:app-bundle": "bash ./bin/lattices-build package",
    "build:dev-app": "bash ./bin/lattices-build dev",
    "build:dist": "bash ./bin/lattices-build dist",
    "build:dist:local": "bash ./bin/lattices-build dist:local",
    "prepack": "bash ./bin/lattices-build package",
    "linux:app": "bun apps/linux/main.ts",
    "linux:install": "bun apps/linux/install.ts",
    "test:linux-install": "bun test tests/linux-install.test.ts"
  },
  "type": "module",
  "os": ["darwin"],
  "files": [
    "bin",
    "packages/npm/sdk/cua.mjs",
    "packages/npm/sdk/cua.d.ts",
    "packages/npm/sdk/cua.d.mts",
    "apps/mac/Info.plist",
    "apps/mac/Lattices.app",
    "apps/mac/Lattices.entitlements",
    "apps/mac/Resources",
    "assets/AppIcon.icns",
    "docs"
  ],
  "devDependencies": {
    "bun-types": "^1.3.10",
    "typescript": "^5.9.3"
  }
}
