{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["bun-types"]
  },
  "include": ["bin/**/*.ts", "packages/host-linux/**/*.ts", "packages/desktop-client/**/*.ts", "apps/linux/**/*.ts"],
  "exclude": ["apps/linux/test/*.test.ts", "node_modules", "apps/mac", "apps/site"]
}
